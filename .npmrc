# Las herramientas de build (autoprefixer, typescript, tailwindcss-animate) viven en
# devDependencies. Si el entorno de build define NODE_ENV=production, npm deriva
# omit=dev y `npm ci` las salta, rompiendo `next build`.
# `include` tiene precedencia sobre `omit`, asi que esto garantiza devDependencies
# en cualquier host (EasyPanel/Nixpacks, CI, Docker) sin depender de configuracion externa.
# Ver docs/reference/deuda-tecnica.md, anti-deuda "`NODE_ENV` en EasyPanel: NO fijar".
include=dev
